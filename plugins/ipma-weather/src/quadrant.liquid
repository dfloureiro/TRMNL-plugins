{% if lang == "pt" %}
  {% assign label_today = "HOJE" %}
{% else %}
  {% assign label_today = "TODAY" %}
{% endif %}

{% assign tomorrow = data[1] %}

<div class="layout layout--row lg:portrait:layout--col layout--center gap--small">
  <div class="flex flex--col flex--center gap--xsmall grow">
    <span class="label label--small">{{ label_today }}</span>

    <img
      class="image image--adaptive h--[26cqh] lg:portrait:h--[18cqh] w--max-[30cqw]"
      src="{{ icon_url }}"
      alt="{{ weather }}"
    >

    <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ today.tMax | round }}°</span>
    <span class="label text--center" data-clamp="1">{{ weather }}</span>
    <span class="label label--small">{{ today.tMin | round }}° · {{ today.precipitaProb | round }}%</span>
  </div>

  <div class="divider--v lg:portrait:hidden"></div>
  <div class="divider w--full hidden lg:portrait:block"></div>

  <div class="flex flex--col flex--center gap--xsmall grow">
    <span class="label label--small">{% render "weekday", date_str: tomorrow.forecastDate, lang: lang %}</span>

    <img
      class="image image--adaptive h--[26cqh] lg:portrait:h--[18cqh] w--max-[30cqw]"
      src="https://trmnl.com/images/plugins/weather/{{ icon }}.svg"
      alt=""
      hidden
    >
    {% render "day_icon_img", day: tomorrow, icon_class: "h--[26cqh] lg:portrait:h--[18cqh] w--max-[30cqw]" %}

    <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ tomorrow.tMax | round }}°</span>
    <span class="label label--small">{{ tomorrow.tMin | round }}° · {{ tomorrow.precipitaProb | round }}%</span>
  </div>
</div>

{% render "title_bar", display_name: display_name %}