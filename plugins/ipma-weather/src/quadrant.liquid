{% if lang == "pt" %}
  {% assign label_today = "HOJE" %}
{% else %}
  {% assign label_today = "TODAY" %}
{% endif %}

{% assign tomorrow = data[1] %}

<div class="layout layout--row portrait:layout--col gap--auto">
  <div class="flex flex--col flex--center gap--xsmall grow">
    <span class="label label--small">{{ label_today }}</span>

    <img
      class="image image--adaptive h--[22cqh] portrait:h--[12cqh] w--max-[26cqw] portrait:w--max-[20cqw]"
      src="{{ icon_url }}"
      alt="{{ weather }}"
    >

    <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ today.tMax | round }}°</span>
    <span class="label label--small text--center portrait:hidden">{{ weather }}</span>

    <div class="flex flex--row portrait:flex--col flex--center gap--small">
      <span class="label label--small value--tnums">{{ label_min }} {{ today.tMin | round }}°</span>
      <span class="label label--small value--tnums">{{ label_rain }} {{ today.precipitaProb | round }}%</span>
    </div>
  </div>

  <div class="divider--v portrait:hidden"></div>
  <div class="divider w--full hidden portrait:block"></div>

  <div class="flex flex--col flex--center gap--xsmall grow">
    <span class="label label--small">{% render "weekday", date_str: tomorrow.forecastDate, lang: lang %}</span>

    {% render "day_icon_img", day: tomorrow, icon_class: "h--[22cqh] portrait:h--[12cqh] w--max-[26cqw] portrait:w--max-[20cqw]" %}

    <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ tomorrow.tMax | round }}°</span>

    <div class="flex flex--row portrait:flex--col flex--center gap--small">
      <span class="label label--small value--tnums">{{ label_min }} {{ tomorrow.tMin | round }}°</span>
      <span class="label label--small value--tnums">{{ label_rain }} {{ tomorrow.precipitaProb | round }}%</span>
    </div>
  </div>
</div>

{% render "title_bar", display_name: display_name %}