{% if lang == "pt" %}
  {% assign label_today = "HOJE" %}
{% else %}
  {% assign label_today = "TODAY" %}
{% endif %}

{% assign tomorrow = data[1] %}

<div class="layout layout--row lg:portrait:layout--col layout--center gap--small">
  <div class="flex flex--col flex--center gap--xsmall grow">
    <span class="label label--small">{{ label_today }}</span>

    <img
      class="image image--adaptive h--[20cqh] w--max-[30cqw]"
      src="{{ icon_url }}"
      alt="{{ weather }}"
    >

    <span class="value value--large value--tnums" data-fit-value="true">{{ today.tMax | round }}°</span>
    <span class="label label--small text--center" data-clamp="1">{{ weather }}</span>
    <span class="label label--small">{{ label_min }} {{ today.tMin | round }}° · {{ today.precipitaProb | round }}%</span>
  </div>

  <div class="divider--v lg:portrait:hidden"></div>
  <div class="divider w--full hidden lg:portrait:block"></div>

  <div class="flex flex--col flex--center gap--xsmall grow">
    <span class="label label--small">{% render "weekday", date_str: tomorrow.forecastDate, lang: lang %}</span>

    {% render "day_icon_img", day: tomorrow %}

    <span class="value value--large value--tnums" data-fit-value="true">{{ tomorrow.tMax | round }}°</span>
    <span class="label label--small value--tnums">{{ tomorrow.tMin | round }}°</span>
    <span class="label label--small">{{ label_rain }} {{ tomorrow.precipitaProb | round }}%</span>
  </div>
</div>

{% render "title_bar", display_name: display_name %}