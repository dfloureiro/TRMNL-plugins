<div class="layout layout--col gap--auto">
  <div class="flex flex--col flex--center gap--xsmall w--full h--max-[56cqh]">
    <span class="label label--large">{{ display_name }}</span>

    <img
      class="image image--adaptive h--[18cqh] portrait:h--[13cqh] w--max-[38cqw]"
      src="{{ icon_url }}"
      alt="{{ weather }}"
    >

    <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{{ today.tMax | round }}°</span>
    <span class="label label--large text--center">{{ weather }}</span>
    <div class="flex flex--row flex--center gap--small">
      <span class="label label--small value--tnums">{{ label_min }} {{ today.tMin | round }}°</span>
      <span class="label label--small value--tnums">{{ label_rain }} {{ today.precipitaProb | round }}%</span>
    </div>
  </div>

  <div class="divider w--full"></div>

  <div class="flex flex--row flex--center gap--small w--full">
    {% for day in data offset:1 limit:3 %}
      {% render "day_tile", day: day, lang: lang, icon_class: "h--[11cqh] portrait:h--[9cqh] w--max-[16cqw]", value_class: "value--xsmall lg:value--small", rain_label: label_rain %}
      {% unless forloop.last %}<div class="divider--v"></div>{% endunless %}
    {% endfor %}
  </div>
</div>

{% render "title_bar", display_name: display_name %}