<div class="layout layout--col gap--space-between">
  <div class="flex flex--row flex--center gap--large w--full">
    <img
      class="image image--adaptive h--[26cqh] w--max-[24cqw]"
      src="{{ icon_url }}"
      alt="{{ weather }}"
    >

    <div class="flex flex--col flex--center">
      <span class="label label--large">{{ display_name }}</span>
      <span class="value value--xxxlarge lg:value--giga value--tnums" data-fit-value="true">{{ today.tMax | round }}°</span>
      <span class="label label--large text--center">{{ weather }}</span>
    </div>
  </div>

  <div class="divider w--full"></div>

  <div class="flex flex--row flex--center gap--medium w--full">
    <div class="flex flex--col flex--center gap--xsmall grow">
      <span class="label label--small">{{ label_min }}</span>
      <span class="value value--base lg:value--large value--tnums">{{ today.tMin | round }}°</span>
    </div>
    <div class="divider--v"></div>
    <div class="flex flex--col flex--center gap--xsmall grow">
      <span class="label label--small">{{ label_rain }}</span>
      <span class="value value--base lg:value--large value--tnums">{{ today.precipitaProb | round }}%</span>
    </div>
    <div class="divider--v"></div>
    <div class="flex flex--col flex--center gap--xsmall grow">
      <span class="label label--small">{{ label_wind }}</span>
      <span class="label label--large text--center">{{ today.predWindDir }} · {{ wind_speed }}</span>
    </div>
  </div>

  <div class="divider w--full"></div>

  <div class="flex flex--row flex--center gap--medium w--full">
    {% for day in data offset:1 limit:4 %}
      {% render "day_tile", day: day, lang: lang, icon_class: "h--[14cqh] lg:h--[16cqh] w--max-[16cqw]" %}
      {% unless forloop.last %}<div class="divider--v"></div>{% endunless %}
    {% endfor %}
  </div>
</div>

{% render "title_bar", display_name: display_name %}