<div class="layout layout--row lg:portrait:layout--col layout--center gap--medium">
  <div class="flex flex--row lg:portrait:flex--row flex--center gap--medium">
    <img
      class="image image--adaptive h--[24cqh] w--max-[22cqw]"
      src="{{ icon_url }}"
      alt="{{ weather }}"
    >

    <div class="flex flex--col flex--center">
      <span class="value value--xxlarge value--tnums" data-fit-value="true">{{ today.tMax | round }}°</span>
      <span class="label text--center" data-clamp="1">{{ weather }}</span>
      <span class="label label--small">{{ label_min }} {{ today.tMin | round }}° · {{ label_rain }} {{ today.precipitaProb | round }}%</span>
    </div>
  </div>

  <div class="divider--v lg:portrait:hidden"></div>
  <div class="divider w--full hidden lg:portrait:block"></div>

  <div class="flex flex--row flex--center gap--small grow w--full">
    {% for day in data offset:1 limit:3 %}
      {% render "day_tile", day: day, lang: lang %}
      {% unless forloop.last %}<div class="divider--v"></div>{% endunless %}
    {% endfor %}
  </div>
</div>

{% render "title_bar", display_name: display_name %}