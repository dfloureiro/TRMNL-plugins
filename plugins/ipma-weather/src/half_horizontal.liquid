<div class="layout layout--row layout--center gap--small lg:gap--medium">
  <div class="flex flex--col flex--center gap--xsmall">
    <img
      class="image image--adaptive w--[10cqw] h--[10cqw] portrait:w--[14cqw] portrait:h--[14cqw] lg:w--[12cqw] lg:h--[12cqw]"
      src="{{ icon_url }}"
      alt="{{ weather }}"
    >
    <span class="label label--small text--center">{{ display_name }}</span>
  </div>

  <div class="flex flex--col flex--center gap--xsmall">
    <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ today.tMax | round }}°</span>
    <span class="label label--small text--center">{{ weather }}</span>
    <span class="label label--small">{{ label_min }} {{ today.tMin | round }}°</span>
    <span class="label label--small">{{ label_rain }} {{ today.precipitaProb | round }}%</span>
    <span class="label label--small hidden lg:block">{{ label_wind }} {{ today.predWindDir }} · {{ wind_speed }}</span>
  </div>

  <div class="divider--v"></div>

  <div class="flex flex--row flex--center gap--small grow">
    {% for day in data offset:1 limit:3 %}
      <div class="flex flex--col flex--center gap--xsmall grow {% unless forloop.last %}border--v{% endunless %}">
        <span class="label label--small">{{ day.forecastDate | date: "%a" | capitalize }}</span>

        {% render "day_icon_img", day: day, icon_class: "w--[6cqw] h--[6cqw] lg:w--[8cqw] lg:h--[8cqw]" %}

        <div class="flex flex--row flex--center gap--xsmall">
          <span class="value value--xsmall value--tnums">{{ day.tMax | round }}°</span>
          <span class="label label--small value--tnums">{{ day.tMin | round }}°</span>
        </div>

        <div class="flex flex--row flex--center gap--xsmall">
          <img
            class="image image--adaptive w--[3cqw] h--[3cqw]"
            src="https://trmnl.com/images/plugins/weather/wi-raindrop.svg"
            alt=""
          >
          <span class="label label--small value--tnums">{{ day.precipitaProb | round }}%</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% render "title_bar", display_name: display_name %}