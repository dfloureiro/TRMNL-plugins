{% template day_icon_img %}
  {% case day.idWeatherType %}
    {% when 1 %}{% assign day_icon = "wi-day-sunny" %}
    {% when 2 %}{% assign day_icon = "wi-day-cloudy" %}
    {% when 3 %}{% assign day_icon = "wi-day-sunny-overcast" %}
    {% when 4 %}{% assign day_icon = "wi-cloudy" %}
    {% when 5 %}{% assign day_icon = "wi-day-cloudy-high" %}
    {% when 6 %}{% assign day_icon = "wi-day-showers" %}
    {% when 7 %}{% assign day_icon = "wi-day-sprinkle" %}
    {% when 8 %}{% assign day_icon = "wi-day-storm-showers" %}
    {% when 9 %}{% assign day_icon = "wi-day-rain" %}
    {% when 10 %}{% assign day_icon = "wi-day-sprinkle" %}
    {% when 11 %}{% assign day_icon = "wi-rain" %}
    {% when 12 %}{% assign day_icon = "wi-day-rain" %}
    {% when 13 %}{% assign day_icon = "wi-day-sprinkle" %}
    {% when 14 %}{% assign day_icon = "wi-day-rain" %}
    {% when 15 %}{% assign day_icon = "wi-sprinkle" %}
    {% when 16 %}{% assign day_icon = "wi-fog" %}
    {% when 17 %}{% assign day_icon = "wi-fog" %}
    {% when 18 %}{% assign day_icon = "wi-snow" %}
    {% when 19 %}{% assign day_icon = "wi-thunderstorm" %}
    {% when 20 %}{% assign day_icon = "wi-day-storm-showers" %}
    {% when 21 %}{% assign day_icon = "wi-hail" %}
    {% when 22 %}{% assign day_icon = "wi-day-haze" %}
    {% when 23 %}{% assign day_icon = "wi-thunderstorm" %}
    {% when 24 %}{% assign day_icon = "wi-cloudy-gusts" %}
    {% when 25 %}{% assign day_icon = "wi-cloudy" %}
    {% when 26 %}{% assign day_icon = "wi-fog" %}
    {% when 27 %}{% assign day_icon = "wi-cloudy" %}
    {% when 28 %}{% assign day_icon = "wi-snow" %}
    {% when 29 %}{% assign day_icon = "wi-rain-mix" %}
    {% when 30 %}{% assign day_icon = "wi-rain-mix" %}
    {% else %}{% assign day_icon = "wi-na" %}
  {% endcase %}
  <img
    class="image image--adaptive {{ icon_class }}"
    src="https://trmnl.com/images/plugins/weather/{{ day_icon }}.svg"
    alt=""
  >
{% endtemplate %}

{% template day_tile %}
  <div class="flex flex--col flex--center gap--xsmall grow">
    <span class="label">{% render "weekday", date_str: day.forecastDate, lang: lang %}</span>

    {% render "day_icon_img", day: day, icon_class: icon_class %}

    <div class="flex flex--row flex--center gap--xsmall">
      <span class="value value--small lg:value--base value--tnums">{{ day.tMax | round }}°</span>
      <span class="label value--tnums">{{ day.tMin | round }}°</span>
    </div>

    <span class="label value--tnums">{{ day.precipitaProb | round }}%</span>
  </div>
{% endtemplate %}