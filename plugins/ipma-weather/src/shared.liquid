{% assign lang = "" %}
{% if language != blank %}
  {% assign lang = language %}
{% elsif trmnl.plugin_settings.custom_fields_values.language != blank %}
  {% assign lang = trmnl.plugin_settings.custom_fields_values.language %}
{% else %}
  {% assign lang = "en" %}
{% endif %}

{% assign lang = lang | downcase | strip %}

{% if lang == "pt" or lang == "portugues" or lang == "português" or lang == "portuguese" %}
  {% assign lang = "pt" %}
{% else %}
  {% assign lang = "en" %}
{% endif %}

{% assign today = data[0] %}

{% if trmnl.plugin_settings.custom_fields_values.location_name != blank %}
  {% assign display_name = trmnl.plugin_settings.custom_fields_values.location_name %}
{% elsif location_name != blank %}
  {% assign display_name = location_name %}
{% else %}
  {% assign display_name = "IPMA" %}
{% endif %}

{% if lang == "pt" %}
  {% assign label_min = "mín" %}
  {% assign label_rain = "Chuva" %}
  {% assign label_wind = "Vento" %}
{% else %}
  {% assign label_min = "min" %}
  {% assign label_rain = "Rain" %}
  {% assign label_wind = "Wind" %}
{% endif %}

{% case today.idWeatherType %}
  {% when 1 %}
    {% if lang == "pt" %}{% assign weather = "Céu limpo" %}{% else %}{% assign weather = "Clear sky" %}{% endif %}
    {% assign icon = "wi-day-sunny" %}
  {% when 2 %}
    {% if lang == "pt" %}{% assign weather = "Céu pouco nublado" %}{% else %}{% assign weather = "Partly cloudy" %}{% endif %}
    {% assign icon = "wi-day-cloudy" %}
  {% when 3 %}
    {% if lang == "pt" %}{% assign weather = "Céu parcialmente nublado" %}{% else %}{% assign weather = "Sunny intervals" %}{% endif %}
    {% assign icon = "wi-day-sunny-overcast" %}
  {% when 4 %}
    {% if lang == "pt" %}{% assign weather = "Céu muito nublado" %}{% else %}{% assign weather = "Cloudy" %}{% endif %}
    {% assign icon = "wi-cloudy" %}
  {% when 5 %}
    {% if lang == "pt" %}{% assign weather = "Nuvens altas" %}{% else %}{% assign weather = "High clouds" %}{% endif %}
    {% assign icon = "wi-day-cloudy-high" %}
  {% when 6 %}
    {% if lang == "pt" %}{% assign weather = "Aguaceiros/chuva" %}{% else %}{% assign weather = "Showers" %}{% endif %}
    {% assign icon = "wi-day-showers" %}
  {% when 7 %}
    {% if lang == "pt" %}{% assign weather = "Aguaceiros fracos" %}{% else %}{% assign weather = "Light showers" %}{% endif %}
    {% assign icon = "wi-day-sprinkle" %}
  {% when 8 %}
    {% if lang == "pt" %}{% assign weather = "Aguaceiros fortes" %}{% else %}{% assign weather = "Heavy showers" %}{% endif %}
    {% assign icon = "wi-day-storm-showers" %}
  {% when 9 %}
    {% if lang == "pt" %}{% assign weather = "Chuva" %}{% else %}{% assign weather = "Rain" %}{% endif %}
    {% assign icon = "wi-day-rain" %}
  {% when 10 %}
    {% if lang == "pt" %}{% assign weather = "Chuva fraca" %}{% else %}{% assign weather = "Light rain" %}{% endif %}
    {% assign icon = "wi-day-sprinkle" %}
  {% when 11 %}
    {% if lang == "pt" %}{% assign weather = "Chuva forte" %}{% else %}{% assign weather = "Heavy rain" %}{% endif %}
    {% assign icon = "wi-rain" %}
  {% when 12 %}
    {% if lang == "pt" %}{% assign weather = "Períodos de chuva" %}{% else %}{% assign weather = "Periods of rain" %}{% endif %}
    {% assign icon = "wi-day-rain" %}
  {% when 13 %}
    {% if lang == "pt" %}{% assign weather = "Períodos de chuva fraca" %}{% else %}{% assign weather = "Periods of light rain" %}{% endif %}
    {% assign icon = "wi-day-sprinkle" %}
  {% when 14 %}
    {% if lang == "pt" %}{% assign weather = "Períodos de chuva forte" %}{% else %}{% assign weather = "Periods of heavy rain" %}{% endif %}
    {% assign icon = "wi-day-rain" %}
  {% when 15 %}
    {% if lang == "pt" %}{% assign weather = "Chuvisco" %}{% else %}{% assign weather = "Drizzle" %}{% endif %}
    {% assign icon = "wi-sprinkle" %}
  {% when 16 %}
    {% if lang == "pt" %}{% assign weather = "Neblina" %}{% else %}{% assign weather = "Mist" %}{% endif %}
    {% assign icon = "wi-fog" %}
  {% when 17 %}
    {% if lang == "pt" %}{% assign weather = "Nevoeiro" %}{% else %}{% assign weather = "Fog" %}{% endif %}
    {% assign icon = "wi-fog" %}
  {% when 18 %}
    {% if lang == "pt" %}{% assign weather = "Neve" %}{% else %}{% assign weather = "Snow" %}{% endif %}
    {% assign icon = "wi-snow" %}
  {% when 19 %}
    {% if lang == "pt" %}{% assign weather = "Trovoada" %}{% else %}{% assign weather = "Thunderstorms" %}{% endif %}
    {% assign icon = "wi-thunderstorm" %}
  {% when 20 %}
    {% if lang == "pt" %}{% assign weather = "Aguaceiros e trovoada" %}{% else %}{% assign weather = "Showers and thunderstorms" %}{% endif %}
    {% assign icon = "wi-day-storm-showers" %}
  {% when 21 %}
    {% if lang == "pt" %}{% assign weather = "Granizo" %}{% else %}{% assign weather = "Hail" %}{% endif %}
    {% assign icon = "wi-hail" %}
  {% when 22 %}
    {% if lang == "pt" %}{% assign weather = "Geada" %}{% else %}{% assign weather = "Frost" %}{% endif %}
    {% assign icon = "wi-day-haze" %}
  {% when 23 %}
    {% if lang == "pt" %}{% assign weather = "Trovoada e chuva" %}{% else %}{% assign weather = "Thunderstorms and rain" %}{% endif %}
    {% assign icon = "wi-thunderstorm" %}
  {% when 24 %}
    {% if lang == "pt" %}{% assign weather = "Nebulosidade convectiva" %}{% else %}{% assign weather = "Convective cloud" %}{% endif %}
    {% assign icon = "wi-cloudy-gusts" %}
  {% when 25 %}
    {% if lang == "pt" %}{% assign weather = "Céu nublado" %}{% else %}{% assign weather = "Overcast" %}{% endif %}
    {% assign icon = "wi-cloudy" %}
  {% when 26 %}
    {% if lang == "pt" %}{% assign weather = "Nevoeiro" %}{% else %}{% assign weather = "Fog" %}{% endif %}
    {% assign icon = "wi-fog" %}
  {% when 27 %}
    {% if lang == "pt" %}{% assign weather = "Céu nublado" %}{% else %}{% assign weather = "Cloudy" %}{% endif %}
    {% assign icon = "wi-cloudy" %}
  {% when 28 %}
    {% if lang == "pt" %}{% assign weather = "Neve" %}{% else %}{% assign weather = "Snow" %}{% endif %}
    {% assign icon = "wi-snow" %}
  {% when 29 %}
    {% if lang == "pt" %}{% assign weather = "Chuva e neve" %}{% else %}{% assign weather = "Rain and snow" %}{% endif %}
    {% assign icon = "wi-rain-mix" %}
  {% when 30 %}
    {% if lang == "pt" %}{% assign weather = "Chuva e neve" %}{% else %}{% assign weather = "Rain and snow" %}{% endif %}
    {% assign icon = "wi-rain-mix" %}
  {% else %}
    {% assign weather = "—" %}
    {% assign icon = "wi-na" %}
{% endcase %}

{% assign icon_url = "https://trmnl.com/images/plugins/weather/" | append: icon | append: ".svg" %}

{% case today.classWindSpeed %}
  {% when 0 %}
    {% if lang == "pt" %}{% assign wind_speed = "Calmo" %}{% else %}{% assign wind_speed = "Calm" %}{% endif %}
  {% when 1 %}
    {% if lang == "pt" %}{% assign wind_speed = "Fraco" %}{% else %}{% assign wind_speed = "Light" %}{% endif %}
  {% when 2 %}
    {% if lang == "pt" %}{% assign wind_speed = "Moderado" %}{% else %}{% assign wind_speed = "Moderate" %}{% endif %}
  {% when 3 %}
    {% if lang == "pt" %}{% assign wind_speed = "Forte" %}{% else %}{% assign wind_speed = "Strong" %}{% endif %}
  {% when 4 %}
    {% if lang == "pt" %}{% assign wind_speed = "Muito forte" %}{% else %}{% assign wind_speed = "Very strong" %}{% endif %}
  {% when 5 %}
    {% if lang == "pt" %}{% assign wind_speed = "Excecional" %}{% else %}{% assign wind_speed = "Exceptional" %}{% endif %}
  {% else %}
    {% assign wind_speed = "" %}
{% endcase %}

{% template weekday %}
  {% assign dow = date_str | date: "%w" | plus: 0 %}
  {% if lang == "pt" %}
    {% case dow %}
      {% when 0 %}Dom
      {% when 1 %}Seg
      {% when 2 %}Ter
      {% when 3 %}Qua
      {% when 4 %}Qui
      {% when 5 %}Sex
      {% when 6 %}Sáb
    {% endcase %}
  {% else %}
    {{ date_str | date: "%a" | capitalize }}
  {% endif %}
{% endtemplate %}

{% template day_icon_img %}
  {% case day.idWeatherType %}
    {% when 1 %}{% assign day_icon = "wi-day-sunny" %}
    {% when 2 %}{% assign day_icon = "wi-day-cloudy" %}
    {% when 3 %}{% assign day_icon = "wi-day-sunny-overcast" %}
    {% when 4 %}{% assign day_icon = "wi-cloudy" %}
    {% when 5 %}{% assign day_icon = "wi-day-cloudy-high" %}
    {% when 6 %}{% assign day_icon = "wi-day-showers" %}
    {% when 7 %}{% assign day_icon = "wi-day-sprinkle" %}
    {% when 8 %}{% assign day_icon = "wi-day-storm-showers" %}
    {% when 9 %}{% assign day_icon = "wi-day-rain" %}
    {% when 10 %}{% assign day_icon = "wi-day-sprinkle" %}
    {% when 11 %}{% assign day_icon = "wi-rain" %}
    {% when 12 %}{% assign day_icon = "wi-day-rain" %}
    {% when 13 %}{% assign day_icon = "wi-day-sprinkle" %}
    {% when 14 %}{% assign day_icon = "wi-day-rain" %}
    {% when 15 %}{% assign day_icon = "wi-sprinkle" %}
    {% when 16 %}{% assign day_icon = "wi-fog" %}
    {% when 17 %}{% assign day_icon = "wi-fog" %}
    {% when 18 %}{% assign day_icon = "wi-snow" %}
    {% when 19 %}{% assign day_icon = "wi-thunderstorm" %}
    {% when 20 %}{% assign day_icon = "wi-day-storm-showers" %}
    {% when 21 %}{% assign day_icon = "wi-hail" %}
    {% when 22 %}{% assign day_icon = "wi-day-haze" %}
    {% when 23 %}{% assign day_icon = "wi-thunderstorm" %}
    {% when 24 %}{% assign day_icon = "wi-cloudy-gusts" %}
    {% when 25 %}{% assign day_icon = "wi-cloudy" %}
    {% when 26 %}{% assign day_icon = "wi-fog" %}
    {% when 27 %}{% assign day_icon = "wi-cloudy" %}
    {% when 28 %}{% assign day_icon = "wi-snow" %}
    {% when 29 %}{% assign day_icon = "wi-rain-mix" %}
    {% when 30 %}{% assign day_icon = "wi-rain-mix" %}
    {% else %}{% assign day_icon = "wi-na" %}
  {% endcase %}
  <img
    class="image image--adaptive {{ icon_class }}"
    src="https://trmnl.com/images/plugins/weather/{{ day_icon }}.svg"
    alt=""
  >
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <img class="image image--adaptive" src="https://trmnl.com/images/plugins/weather/wi-thermometer.svg" alt="IPMA Weather">
  <span class="title">IPMA</span>
  <span class="instance">{{ display_name }}</span>
</div>
{% endtemplate %}

{% template chef_layout_anchor %}
<div class="layout layout--col"></div>
{% endtemplate %}