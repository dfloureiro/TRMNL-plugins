{% if plugin_ok %}
<div class="layout layout--col gap--small lg:gap--space-between">
  <div class="flex flex--col flex--center gap--xsmall">
    <span class="label label--small">{{ display_name }}</span>
    {% render "mode_icon", trmnl: trmnl %}
    <span class="label label--small">{{ label_leave_by }}</span>
    <span class="value value--xlarge lg:value--xxxlarge value--tnums" data-fit-value="true">{{ leave_time }}</span>
    <span class="label label--small lg:label--large">{{ label_arrive_by }} {{ arrive_time }}</span>
    <span class="label label--small">{{ travel_min }} {{ label_mins }} · {{ distance_km }} km · {{ traffic_text }}</span>
  </div>

  <div class="flex flex--col gap--xsmall lg:gap--small w--full">
    {% for r in routes limit:2 %}
      {% assign r_roads = "" | split: "" %}
      {% for instr in r.guidance.instructions %}
        {% if instr.roadNumbers %}
          {% assign r_roads = r_roads | concat: instr.roadNumbers %}
        {% endif %}
      {% endfor %}
      {% assign r_roads = r_roads | uniq %}
      {% assign r_leave = "--:--" %}
      {% if r.summary.departureTime != blank %}
        {% assign r_leave = r.summary.departureTime | date: "%H:%M" %}
      {% endif %}
      {% assign r_min = r.summary.travelTimeInSeconds | plus: 0 | divided_by: 60 %}

      <div class="flex flex--col flex--center gap--xsmall outline p--1 lg:p--2 w--full">
        <div class="flex flex--row flex--between w--full">
          <span class="label label--small label--underline">
            {% if forloop.first %}{{ label_main_route }}{% else %}{{ label_alt_route }} {{ forloop.index | minus: 1 }}{% endif %}
          </span>
          <span class="value value--xsmall lg:value--small value--tnums">{{ r_leave }}</span>
        </div>
        <span class="label label--small value--tnums">{{ r_min }} {{ label_mins }}</span>
        <span class="label label--small text--center hidden lg:block">
          {% if r_roads.size > 0 %}
            {{ label_via }} {{ r_roads | join: " · " }}
          {% else %}
            {{ label_via }} —
          {% endif %}
        </span>
      </div>
    {% endfor %}
  </div>
</div>
{% else %}
  {% render "error_panel",
     display_name: display_name,
     label_error: label_error,
     error_text: error_text,
     trmnl: trmnl
  %}
{% endif %}

{% render "title_bar", display_name: display_name, traffic_text: traffic_text %}