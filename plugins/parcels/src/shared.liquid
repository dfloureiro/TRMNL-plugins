{% comment %}
  Data arrives through the plugin's webhook, sent by the companion app (../app):
    parcels: [{ "id": "LX123456789PT", "label": "Headphones", "code": "4821" }, …]
    updated: "17 Nov, 10:21" (already formatted on the phone, in its time zone)
  Every field of a parcel is optional except that the app requires an id or a label.
{% endcomment %}

{% comment %}
  The only custom CSS: the Framework gives the TRMNL Frame (2560x1440) UI scale 1 and no lg: sizes,
  so without this everything renders at OG pixel sizes on a canvas over three times wider.
  Tripling the scale lays it out like an 853x480 screen. No other device has screen--frame.
{% endcomment %}
<style>
  .screen--frame { --device-ui-scale: 3; --gap-scale: 3; }
  /* Framework width classes don't follow the UI scale, so the setup QR code is scaled here too. */
  .screen--frame .parcels-qr { zoom: 3; }
</style>

{% comment %} Language: English unless the form (or a top-level value) asks for Portuguese. {% endcomment %}
{% assign lang = language | default: trmnl.plugin_settings.custom_fields_values.language | default: "en" | downcase | strip %}
{% if lang contains "pt" or lang contains "portug" %}{% assign lang = "pt" %}{% else %}{% assign lang = "en" %}{% endif %}
{% if lang == "pt" %}
  {% assign t_title = "Encomendas" %}
  {% assign t_empty = "Nenhuma encomenda à espera." %}
  {% assign t_setup = "Adicione encomendas na aplicação do telemóvel." %}
  {% assign t_start = "Abra a app no telemóvel para começar." %}
  {% assign t_updated = "Atualizado" %}
{% else %}
  {% assign t_title = "Parcels" %}
  {% assign t_empty = "No parcels on the way." %}
  {% assign t_setup = "Add parcels from the app on your phone." %}
  {% assign t_start = "Open the app on your phone to get started." %}
  {% assign t_updated = "Updated" %}
{% endif %}

{% assign parcel_count = parcels.size | default: 0 %}
{% comment %} Nothing has ever been posted to the webhook: show how to get the companion app. {% endcomment %}
{% assign app_url = "https://dfloureiro.github.io/TRMNL-plugins/" %}
{% assign never_synced = true %}
{% if updated != blank or parcels %}{% assign never_synced = false %}{% endif %}
{% if never_synced %}{% assign t_empty = t_start %}{% endif %}
{% capture meta %}{% if parcel_count > 0 %}{{ parcel_count }}{% endif %}{% if parcel_count > 0 and updated != blank %} · {% endif %}{% if updated != blank %}{{ t_updated }} {{ updated }}{% endif %}{% endcapture %}

{% comment %} A box drawn as an inline SVG, so the title bar needs no hosted image. {% endcomment %}
{% capture box_icon %}data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linejoin='round'%3E%3Cpath d='M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z'/%3E%3Cpath d='M3 7.5 12 12l9-4.5M12 12v9M7.5 5.25l9 4.5'/%3E%3C/svg%3E{% endcapture %}

{% comment %}
  The parcel list, built only from Framework components: a .columns container whose overflow
  engine spreads the items over up to max_cols columns (one in portrait), hides what doesn't fit
  and adds an "and N more" line. title_class / text_class / code_class set the sizes.
{% endcomment %}
{% template parcel_list %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="{{ max_cols }}" data-overflow-max-cols-portrait="1" data-overflow-counter="true">
    <div class="column">
      {% for p in parcels %}
        {% assign heading = p.label | default: p.id %}
        <div class="item">
          <div class="content grow">
            <span class="title {{ title_class }}">{{ heading | escape }}</span>
            {% if p.label != blank and p.id != blank %}<span class="label {{ text_class }} value--tnums">{{ p.id | escape }}</span>{% endif %}
          </div>
          {% if p.code != blank %}
            <span class="value {{ code_class }} value--tnums text--white bg--black rounded--small px--2 shrink-0 self--center">{{ p.code | escape }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endtemplate %}

{% template empty_panel %}
  <div class="layout layout--col flex flex--center gap--small">
    {% if setup %}
      <div class="flex {% if row %}flex--row portrait:flex--col{% else %}flex--col{% endif %} flex--center gap">
        <div class="parcels-qr shrink-0 {{ qr_class }}">{{ app_url | qr_code }}</div>
        <div class="flex flex--col gap--xsmall {% if row %}flex--left portrait:flex--center-x portrait:text--center{% else %}flex--center-x text--center{% endif %}">
          <span class="title">{{ message }}</span>
          <span class="label">{{ app_url | remove: "https://" }}</span>
        </div>
      </div>
    {% else %}
      <img src="{{ icon }}" alt="" class="image image--contain image-dither h--16 w--16 lg:h--24 lg:w--24" />
      <span class="title text--center">{{ message }}</span>
      <span class="label text--center">{{ hint }}</span>
    {% endif %}
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    <img src="{{ icon }}" alt="" class="image image-dither" />
    <span class="title">{{ title }}</span>
    {% if meta != blank %}<span class="instance">{{ meta }}</span>{% endif %}
  </div>
{% endtemplate %}

{% if lang == "pt" %}
{% comment %} The overflow engine reads its "and N more" text from window.I18n. {% endcomment %}
<script>
  window.I18n = window.I18n || {};
  window.I18n.andXMore = function (n) { return "e mais " + n; };
</script>
{% endif %}
