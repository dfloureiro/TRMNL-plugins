{% if parcel_count > 0 %}
<div class="layout layout--col layout--top layout--stretch-x">
  {% render "parcel_list", parcels: parcels, max_cols: 1, title_class: "title--small lg:title", text_class: "label--small lg:label", code_class: "value--xxsmall lg:value--xsmall" %}
</div>
{% else %}
  {% render "empty_panel", icon: box_icon, message: t_empty, hint: t_setup, setup: never_synced, app_url: app_url, row: true, qr_class: "w--28 lg:w--36" %}
{% endif %}
{% render "title_bar", icon: box_icon, title: t_title, meta: meta %}
