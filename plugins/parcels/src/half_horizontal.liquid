{% if parcel_count > 0 %}
<div class="layout layout--col layout--top layout--stretch-x">
  {% render "parcel_list", parcels: parcels, max_cols: 2, title_class: "title lg:title--large", text_class: "label lg:label--large", code_class: "value--xsmall lg:value--small" %}
</div>
{% else %}
  {% render "empty_panel", icon: box_icon, message: t_empty, hint: t_setup, setup: never_synced, app_url: app_url, row: true, qr_class: "w--28 lg:w--40" %}
{% endif %}
{% render "title_bar", icon: box_icon, title: t_title, meta: meta %}
