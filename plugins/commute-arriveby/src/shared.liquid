{% template error_panel %}
  <div class="layout layout--col layout--center gap--small">
    {% render "mode_icon", icon_class: "h--[16cqh] w--max-[20cqw]" %}
    <span class="label label--large text--center">{{ display_name }}</span>
    <span class="label text--center">{{ error_text }}</span>
  </div>
{% endtemplate %}

{% template routes_panel %}
  <div class="grid grid--cols-2 lg:grid--cols-3 lg:portrait:grid--cols-2 gap--small lg:gap--medium w--full">
    {% for r in routes limit:3 %}
      {% assign r_roads = "" | split: "" %}
      {% for instr in r.guidance.instructions %}
        {% if instr.roadNumbers %}
          {% assign r_roads = r_roads | concat: instr.roadNumbers %}
        {% endif %}
      {% endfor %}
      {% assign r_roads = r_roads | uniq %}

      {% assign r_time = "--:--" %}
      {% if is_arrive_mode %}
        {% if r.summary.departureTime != blank %}
          {% assign r_time = r.summary.departureTime | date: "%H:%M" %}
        {% endif %}
      {% else %}
        {% if r.summary.arrivalTime != blank %}
          {% assign r_time = r.summary.arrivalTime | date: "%H:%M" %}
        {% endif %}
      {% endif %}

      {% assign r_min = r.summary.travelTimeInSeconds | plus: 0 | divided_by: 60 %}
      {% assign r_km = r.summary.lengthInMeters | plus: 0 | divided_by: 1000.0 | round: 1 %}

      <div class="flex flex--col flex--center gap--xsmall outline p--1 lg:p--2 w--full {% if forloop.index > 2 %}hidden lg:flex{% endif %}">
        <span class="label label--small lg:label--large label--underline">
          {% if forloop.first %}{{ label_main_route }}{% else %}{{ label_alt_route }} {{ forloop.index | minus: 1 }}{% endif %}
        </span>
        <span class="value value--small lg:value--large value--tnums">{{ r_time }}</span>
        <span class="label label--small lg:label--base value--tnums">{{ r_min }} {{ label_mins }} · {{ r_km }} km</span>
        <span class="label label--base text--center hidden lg:visible">
          {% if r_roads.size > 0 %}{{ label_via }} {{ r_roads | join: " · " }}{% else %}{{ label_via }} —{% endif %}
        </span>
      </div>
    {% endfor %}
  </div>
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <svg class="image image--adaptive" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">
    <path d="M12 12.584a4.325 4.325 0 0 1-4.32-4.32A4.325 4.325 0 0 1 12 3.944a4.325 4.325 0 0 1 4.32 4.32 4.325 4.325 0 0 1-4.32 4.32zM12 0C7.443 0 3.736 3.707 3.736 8.264c0 4.557 3.707 8.264 8.264 8.264 4.557 0 8.264-3.707 8.264-8.264C20.264 3.707 16.557 0 12 0m0 24 3.167-5.486H8.833Z"/>
  </svg>
  <span class="title">{{ display_name }}</span>
  <span class="instance">{{ direction_text }} · {{ traffic_text }}</span>
</div>
{% endtemplate %}

{% template chef_layout_anchor %}
<div class="layout layout--col"></div>
{% endtemplate %}