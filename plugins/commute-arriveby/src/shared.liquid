{% assign lang = "" %}
{% if language != blank %}
  {% assign lang = language %}
{% elsif trmnl.plugin_settings.custom_fields_values.language != blank %}
  {% assign lang = trmnl.plugin_settings.custom_fields_values.language %}
{% else %}
  {% assign lang = "en" %}
{% endif %}
{% assign lang = lang | downcase | strip %}
{% if lang contains "pt" or lang contains "portug" %}
  {% assign lang = "pt" %}
{% else %}
  {% assign lang = "en" %}
{% endif %}

{% assign arrive_by_setting = "" %}
{% if arrive_by != blank %}
  {% assign arrive_by_setting = arrive_by %}
{% elsif trmnl.plugin_settings.custom_fields_values.arrive_by != blank %}
  {% assign arrive_by_setting = trmnl.plugin_settings.custom_fields_values.arrive_by %}
{% endif %}

{% if arrive_by_setting != blank %}
  {% assign is_arrive_mode = true %}
{% else %}
  {% assign is_arrive_mode = false %}
{% endif %}

{% assign return_setting = trmnl.plugin_settings.custom_fields_values.return_trip %}
{% if return_setting == true or return_setting == "true" %}
  {% assign is_return = true %}
{% else %}
  {% assign is_return = false %}
{% endif %}

{% if route_label != blank %}
  {% assign display_name = route_label %}
{% elsif trmnl.plugin_settings.custom_fields_values.route_label != blank %}
  {% assign display_name = trmnl.plugin_settings.custom_fields_values.route_label %}
{% else %}
  {% assign display_name = "Commute" %}
{% endif %}

{% if lang == "pt" %}
  {% assign label_leave_by = "Sair às" %}
  {% assign label_arrive_by = "Chegar às" %}
  {% assign label_arrival = "Chegada" %}
  {% assign label_travel_time = "Tempo de viagem" %}
  {% assign label_distance = "Distância" %}
  {% assign label_normal = "Sem trânsito" %}
  {% assign label_delay = "Atraso" %}
  {% assign label_mins = "min" %}
  {% assign label_via = "via" %}
  {% assign label_main_route = "Principal" %}
  {% assign label_alt_route = "Alternativa" %}
  {% assign label_outbound = "Ida" %}
  {% assign label_return = "Volta" %}
  {% assign label_clear = "Fluído" %}
  {% assign label_minor = "Ligeiro" %}
  {% assign label_moderate = "Moderado" %}
  {% assign label_major = "Intenso" %}
  {% assign label_closed = "Cortado" %}
  {% assign label_error = "Não foi possível obter a rota" %}
{% else %}
  {% assign label_leave_by = "Leave by" %}
  {% assign label_arrive_by = "Arrive by" %}
  {% assign label_arrival = "Arrival" %}
  {% assign label_travel_time = "Travel time" %}
  {% assign label_distance = "Distance" %}
  {% assign label_normal = "No traffic" %}
  {% assign label_delay = "Delay" %}
  {% assign label_mins = "min" %}
  {% assign label_via = "via" %}
  {% assign label_main_route = "Main" %}
  {% assign label_alt_route = "Alt" %}
  {% assign label_outbound = "Outbound" %}
  {% assign label_return = "Return" %}
  {% assign label_clear = "Clear" %}
  {% assign label_minor = "Minor" %}
  {% assign label_moderate = "Moderate" %}
  {% assign label_major = "Heavy" %}
  {% assign label_closed = "Closed" %}
  {% assign label_error = "Could not load route" %}
{% endif %}

{% if is_return %}
  {% assign direction_text = label_return %}
{% else %}
  {% assign direction_text = label_outbound %}
{% endif %}

{% if plugin_ok == true or plugin_ok == "true" %}
  {% assign plugin_ok = true %}
{% elsif has_error == true or has_error == "true" or routes == blank or routes.size == 0 %}
  {% assign plugin_ok = false %}
{% else %}
  {% assign plugin_ok = true %}
{% endif %}

{% if plugin_ok %}
  {% assign error_text = "" %}
{% elsif error_message != blank %}
  {% assign error_text = error_message %}
{% else %}
  {% assign error_text = label_error %}
{% endif %}

{% assign leave_time = "--:--" %}
{% assign arrive_time = "--:--" %}
{% assign travel_min = 0 %}
{% assign delay_min = 0 %}
{% assign normal_min = 0 %}
{% assign distance_km = 0 %}
{% assign traffic_text = label_clear %}
{% assign road_numbers = "" | split: "" %}

{% if arrive_by_setting != blank %}
  {% assign arrive_time = arrive_by_setting %}
{% endif %}

{% if plugin_ok %}
  {% assign route = routes[0] %}
  {% assign summary = route.summary %}
  {% assign travel_min = summary.travelTimeInSeconds | plus: 0 | divided_by: 60 %}
  {% assign delay_min = summary.trafficDelayInSeconds | plus: 0 | divided_by: 60 %}
  {% assign normal_min = summary.historicTrafficTravelTimeInSeconds | plus: 0 | divided_by: 60 %}
  {% assign distance_km = summary.lengthInMeters | plus: 0 | divided_by: 1000.0 | round: 1 %}

  {% if summary.departureTime != blank %}
    {% assign leave_time = summary.departureTime | date: "%H:%M" %}
  {% endif %}
  {% if summary.arrivalTime != blank %}
    {% assign arrive_time = summary.arrivalTime | date: "%H:%M" %}
  {% endif %}

  {% assign max_delay = 0 %}
  {% for section in route.sections %}
    {% if section.sectionType == "TRAFFIC" %}
      {% if section.magnitudeOfDelay > max_delay %}
        {% assign max_delay = section.magnitudeOfDelay %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% case max_delay %}
    {% when 1 %}{% assign traffic_text = label_minor %}
    {% when 2 %}{% assign traffic_text = label_moderate %}
    {% when 3 %}{% assign traffic_text = label_major %}
    {% when 4 %}{% assign traffic_text = label_closed %}
    {% else %}{% assign traffic_text = label_clear %}
  {% endcase %}

  {% for instr in route.guidance.instructions %}
    {% if instr.roadNumbers %}
      {% assign road_numbers = road_numbers | concat: instr.roadNumbers %}
    {% endif %}
  {% endfor %}
  {% assign road_numbers = road_numbers | uniq %}
{% else %}
  {% assign traffic_text = label_error %}
{% endif %}

