{% template routes_panel %}
  <div class="grid grid--cols-2 lg:grid--cols-3 gap--medium w--full">
    {% for r in routes limit:3 %}
      {% assign r_roads = "" | split: "" %}
      {% for instr in r.guidance.instructions %}
        {% if instr.roadNumbers %}
          {% assign r_roads = r_roads | concat: instr.roadNumbers %}
        {% endif %}
      {% endfor %}
      {% assign r_roads = r_roads | uniq %}
      {% assign r_min = r.summary.travelTimeInSeconds | plus: 0 | divided_by: 60 %}
      {% assign r_km = r.summary.lengthInMeters | plus: 0 | divided_by: 1000.0 | round: 1 %}
      {% assign r_delay = r.summary.trafficDelayInSeconds | plus: 0 | divided_by: 60 %}

      <div class="flex flex--col flex--center gap--xsmall outline outline--2 rounded p--2 w--full">
        <span class="label label--underline">
          {% if forloop.first %}{{ label_main_route }}{% else %}{{ label_alt_route }} {{ forloop.index | minus: 1 }}{% endif %}
        </span>
        <span class="value value--small value--tnums">{{ r_min }} {{ label_mins }}</span>
        <span class="label label--small value--tnums">{{ r_km }} km</span>
        {% if r_delay > 0 %}
          <span class="label label--small">+{{ r_delay }} {{ label_mins }}</span>
        {% endif %}
        <span class="label label--small text--center">
          {% if r_roads.size > 0 %}
            {{ label_via }} {{ r_roads | join: " · " }}
          {% else %}
            {{ label_via }} —
          {% endif %}
        </span>
      </div>
    {% endfor %}
  </div>
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <img class="image image-dither image--adaptive" src="https://trmnl.com/images/plugins/weather/wi-time-4.svg" alt="Commute">
  <span class="title">{{ display_name }}</span>
  <span class="instance">{{ traffic_text }}</span>
</div>
{% endtemplate %}