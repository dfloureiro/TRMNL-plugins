{% if table_ok %}
<div class="layout layout--col layout--top gap--small">
  <div class="flex flex--row flex--between w--full"><span class="label label--base">LEAGUE PHASE</span><span class="label label--small">1–8 DIRECT</span></div>
  <div class="w--full cl-half-vertical-table">
    {% render "table_heading" %}
    {% for row in rows limit:30 %}
      {% if forloop.index > 20 %}<div class="cl-x-portrait-only">{% render "table_row", row: row %}</div>{% elsif forloop.index > 12 %}<div class="cl-x-only">{% render "table_row", row: row %}</div>{% else %}{% render "table_row", row: row %}{% endif %}
    {% endfor %}
  </div>
  {% if featured != blank and featured.position > 12 %}
    <div class="w--full{% if featured.position <= 20 %} cl-og-landscape-only{% elsif featured.position <= 30 %} cl-not-x-portrait{% endif %}"><span class="label label--small">FAVOURITE</span><div class="cl-half-vertical-table">{% render "table_row", row: featured %}</div></div>
  {% endif %}
  <span class="label label--small">9–24 playoff</span>
</div>
{% else %}{% render "error_panel", message: table_error %}{% endif %}
{% render "title_bar", compact: true %}
