{% if table_ok and display_mode == "knockout" %}
<div class="layout layout--col layout--top gap--small">
  <div class="label label--base w--full">{{ round_label | upcase }}</div>
  <div class="grid grid--cols-1 gap--xsmall w--full grow">{% for tie in round_ties limit:6 %}{% if forloop.index > 4 %}<div class="hidden lg:block h--full">{% render "tie_card", tie: tie, round_label: round_label %}</div>{% else %}{% render "tie_card", tie: tie, round_label: round_label %}{% endif %}{% endfor %}</div>
</div>
{% elsif table_ok %}
<div class="layout layout--col layout--top gap--small">
  <div class="flex flex--row flex--between w--full"><span class="label label--base">LEAGUE PHASE</span><span class="label label--small">1–8 DIRECT</span></div>
  <div class="w--full">
    {% render "table_heading", text_class: "label label--small lg:label--base" %}
    {% if featured != blank and featured.position > 20 %}{% assign landscape_limit = 16 %}{% else %}{% assign landscape_limit = 20 %}{% endif %}
    {% for row in rows limit:30 %}
      {% if forloop.index > 20 %}<div class="hidden lg:portrait:block">{% render "table_row", row: row, text_class: "label label--small lg:label--base" %}</div>{% elsif forloop.index > landscape_limit %}<div class="hidden portrait:block lg:block">{% render "table_row", row: row, text_class: "label label--small lg:label--base" %}</div>{% else %}{% render "table_row", row: row, text_class: "label label--small lg:label--base" %}{% endif %}
    {% endfor %}
  </div>
  {% if featured != blank and featured.position > landscape_limit %}
    <div class="w--full portrait:hidden"><span class="label label--small">FAVOURITE</span><div>{% render "table_row", row: featured, text_class: "label label--small lg:label--base" %}</div></div>
  {% endif %}
</div>
{% else %}{% render "error_panel", message: table_error %}{% endif %}
{% render "title_bar", compact: true %}
