{% if table_ok %}
<div class="layout layout--col gap--small">
  <div class="flex flex--row flex--between w--full">
    <span class="label label--base">LEADERS · DIRECT</span>
    <span class="label label--small">P / GD / PTS</span>
  </div>
  <div class="w--full cl-half-horizontal-table">
    {% render "table_heading" %}
    {% if featured != blank and featured.position > 6 %}{% assign row_limit = 4 %}{% else %}{% assign row_limit = 6 %}{% endif %}
    {% for row in rows limit:8 %}
      {% if forloop.index > row_limit %}<div class="hidden lg:block">{% render "table_row", row: row %}</div>{% else %}{% render "table_row", row: row %}{% endif %}
    {% endfor %}
  </div>
  {% if featured != blank and featured.position > row_limit %}
    <div class="w--full{% if featured.position <= 8 %} lg:hidden{% endif %}"><span class="label label--small">FAVOURITE</span>{% render "table_row", row: featured %}</div>
  {% endif %}
</div>
{% else %}{% render "error_panel", message: table_error %}{% endif %}
{% render "title_bar", season_label: season_label %}
