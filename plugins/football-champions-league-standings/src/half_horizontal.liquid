{% if table_ok %}
<div class="layout layout--col layout--top gap--small">
  <div class="w--full cl-half-horizontal-table">
    {% render "table_heading" %}
    {% if featured != blank and featured.position > 8 %}{% assign row_limit = 6 %}{% else %}{% assign row_limit = 8 %}{% endif %}
    {% for row in rows limit:22 %}
      {% if forloop.index > 14 %}<div class="cl-x-portrait-only">{% render "table_row", row: row %}</div>{% elsif forloop.index > row_limit %}<div class="cl-x-only">{% render "table_row", row: row %}</div>{% else %}{% render "table_row", row: row %}{% endif %}
    {% endfor %}
  </div>
  {% if featured != blank and featured.position > 8 %}
    <div class="w--full{% if featured.position <= 14 %} cl-og-landscape-only{% elsif featured.position <= 22 %} cl-not-x-portrait{% endif %}"><span class="label label--small">FAVOURITE</span><div class="cl-half-horizontal-table">{% render "table_row", row: featured %}</div></div>
  {% endif %}
</div>
{% else %}{% render "error_panel", message: table_error %}{% endif %}
{% render "title_bar", season_label: season_label %}
