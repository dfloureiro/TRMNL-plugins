<style>
  .cl-grid { display: grid; grid-template-columns: 2.3em minmax(0, 1fr) 2em 2.4em 2.6em; gap: .2em; }
  .cl-row { align-items: center; min-height: 1.35em; border-bottom: 1px solid #111; }
  .cl-row--break { border-bottom-width: 2px; }
  .cl-row--favorite { box-shadow: inset 4px 0 #111; padding-left: 6px; font-weight: 700; }
  .cl-heading { border-bottom: 2px solid #111; font-weight: 700; }
  .cl-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cl-strong { font-weight: 700; }
  .cl-landscape-table { display: grid; grid-template-columns: 1fr 1fr; gap: 2cqw; font-size: clamp(13px, 2.4cqh, 25px); line-height: 1.25; }
  .cl-portrait-table { font-size: clamp(13px, 1.6cqh, 19px); line-height: 1.25; }
  .cl-half-horizontal-table { font-size: clamp(13px, 2.8cqh, 20px); line-height: 1.25; }
  .cl-half-vertical-table { font-size: clamp(12px, 1.9cqh, 20px); line-height: 1.25; }
  .cl-quadrant-table { font-size: clamp(13px, 3cqh, 21px); line-height: 1.3; }
  .cl-x-only { display: none; }
  .screen--lg .cl-x-only { display: block; }
  .screen--portrait .cl-x-only { display: block; }
  .cl-x-portrait-only { display: none; }
  .screen--lg.screen--portrait .cl-x-portrait-only { display: block; }
  .screen--lg .cl-og-landscape-only, .screen--portrait .cl-og-landscape-only { display: none; }
  .screen--lg.screen--portrait .cl-not-x-portrait { display: none; }
</style>
{% assign table_ok = false %}
{% if plugin_ok == true or plugin_ok == "true" %}{% if rows.size > 0 %}{% assign table_ok = true %}{% endif %}{% endif %}
{% if error_message != blank %}{% assign table_error = error_message %}{% else %}{% assign table_error = "Standings are unavailable right now." %}{% endif %}

{% template table_row %}
  <div class="cl-grid cl-row{% if row.position == 8 or row.position == 24 %} cl-row--break{% endif %}{% if row.favorite %} cl-row--favorite{% endif %}">
    <span class="value--tnums cl-strong">{{ row.position }}</span>
    <span class="cl-name{% if row.favorite %} cl-strong{% endif %}">{{ row.name | escape }}</span>
    <span class="value--tnums text--right">{{ row.played }}</span>
    <span class="value--tnums text--right">{{ row.gd_text }}</span>
    <span class="value--tnums text--right cl-strong">{{ row.points }}</span>
  </div>
{% endtemplate %}

{% template table_heading %}
  <div class="cl-grid cl-heading">
    <span>#</span><span>CLUB</span><span class="text--right">P</span><span class="text--right">GD</span><span class="text--right">PTS</span>
  </div>
{% endtemplate %}

{% template error_panel %}
  <div class="layout layout--col flex flex--center">
    <span class="value value--large">Champions League</span>
    <span class="label label--base text--center">{{ message | escape }}</span>
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    <span class="title">{% if compact %}UCL{% else %}Champions League{% endif %}</span>
    <span class="instance">{% if compact %}Data: football-data.org{% else %}Data provided by football-data.org{% endif %}</span>
  </div>
{% endtemplate %}

{% template chef_layout_anchor %}<div class="layout layout--col"></div>{% endtemplate %}
