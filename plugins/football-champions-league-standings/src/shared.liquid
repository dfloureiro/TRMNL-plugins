<style>
  .cl-grid { display: grid; grid-template-columns: 2.3em minmax(0, 1fr) 2em 2.4em 2.6em; gap: .2em; }
  .cl-row { align-items: center; min-height: 1.35em; border-bottom: 1px solid #111; }
  .cl-row--break { border-bottom-width: 2px; }
  .cl-row--favorite { box-shadow: inset 4px 0 #111; padding-left: 6px; font-weight: 700; }
  .cl-heading { border-bottom: 2px solid #111; font-weight: 700; }
  .cl-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cl-strong { font-weight: 700; }
  .cl-landscape-table { --cl-size: clamp(14px, 2.8cqh, 28px); display: grid; grid-template-columns: 1fr 1fr; gap: 2cqw; line-height: 1.25; }
  .screen--lg .cl-landscape-table { --cl-size: clamp(24px, 3.4cqh, 30px); }
  .cl-portrait-table { --cl-size: clamp(14px, 1.65cqh, 20px); line-height: 1.25; }
  .screen--lg .cl-portrait-table { --cl-size: clamp(18px, 1.8cqh, 22px); }
  .cl-half-horizontal-table { --cl-size: clamp(13px, 2.8cqh, 20px); line-height: 1.25; }
  .screen--portrait .cl-half-horizontal-table { --cl-size: 14px; }
  .screen--lg:not(.screen--portrait) .cl-half-horizontal-table { --cl-size: 16px; }
  .cl-half-vertical-table { --cl-size: clamp(14px, 2.3cqh, 22px); line-height: 1.25; }
  .screen--lg:not(.screen--portrait) .cl-half-vertical-table { --cl-size: 24px; }
  .cl-half-vertical-table .cl-grid { grid-template-columns: 1.2em minmax(0, 1fr) 1.1em 1.7em 1.5em; }
  .cl-quadrant-table { --cl-size: clamp(15px, 4cqh, 26px); line-height: 1.3; }
  .cl-landscape-table, .cl-portrait-table, .cl-half-horizontal-table, .cl-half-vertical-table, .cl-quadrant-table { font-size: var(--cl-size); }
  .screen--lg .cl-quadrant-table { --cl-size: 26px; }
  .cl-quadrant-table .cl-grid { grid-template-columns: 1.5em minmax(0, 1fr) 1.5em 2em 2em; }
  .cl-focus-panel { border: 2px solid #111; flex: 3; }
  .cl-focus-rank { --cl-focus-size: clamp(34px, 18cqh, 92px); line-height: 1; font-weight: 700; }
  .cl-focus-points { --cl-focus-size: clamp(18px, 8cqh, 44px); line-height: 1; font-weight: 700; }
  .cl-focus-name { --cl-focus-size: clamp(20px, 9cqh, 48px); line-height: 1.05; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cl-neighbor-row { display: grid; grid-template-columns: 1.5em minmax(0, 1fr) 2.5em; gap: .35em; align-items: center; min-height: 1.45em; border-bottom: 1px solid #111; }
  .cl-neighbor-row--focus { box-shadow: inset 4px 0 #111; padding-left: 6px; font-weight: 700; }
  .cl-nearby { --cl-focus-size: clamp(14px, 4cqh, 24px); line-height: 1.25; flex: 2; }
  .cl-focus-rank, .cl-focus-points, .cl-focus-name, .cl-nearby { font-size: var(--cl-focus-size); }
  .cl-ties { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); gap: 1.2cqw; width: 100%; min-height: 0; flex: 1; }
  .cl-ties--single { grid-template-columns: 1fr; }
  .screen--portrait .cl-ties { grid-template-columns: 1fr; }
  .cl-tie { border: 2px solid #111; min-width: 0; min-height: 0; }
  .cl-tie--favorite { border-width: 4px; }
  .cl-tie-team { display: grid; grid-template-columns: 2.2em minmax(0, 1fr) 2.5em; gap: .35em; align-items: center; min-height: 1.7em; border-bottom: 1px solid #111; }
  .cl-tie-team:last-child { border-bottom: 0; }
  .cl-tie-crest-frame { display: flex; align-items: center; width: 1.8em; height: 1.8em; overflow: hidden; }
  .cl-tie-crest { display: block; width: 100%; height: 100%; }
  .cl-ties--sparse .cl-tie-team { grid-template-columns: 4.5em minmax(0, 1fr) 1.5em; }
  .cl-ties--sparse .cl-tie-crest-frame { width: 4em; height: 4em; }
  .cl-ties--single .cl-tie-team { grid-template-columns: 7.5em minmax(0, 1fr) 1.5em; }
  .cl-ties--single .cl-tie-crest-frame { width: 7em; height: 7em; }
  .cl-tie-score { font-weight: 700; }
  .cl-tie-meta { border-top: 1px solid #111; }
  .cl-knockout-full { --cl-tie-size: clamp(14px, 2.6cqh, 24px); }
  .cl-knockout-full .cl-ties { gap: 4px; }
  .cl-knockout-full .cl-tie-team { min-height: 1.4em; }
  .cl-knockout-half { --cl-tie-size: clamp(15px, 4cqh, 24px); }
  .cl-knockout-quadrant { --cl-tie-size: clamp(18px, 6cqh, 30px); }
  .cl-knockout-full, .cl-knockout-half, .cl-knockout-quadrant { font-size: var(--cl-tie-size); }
  .cl-knockout-full .cl-tie, .cl-knockout-half .cl-tie { display: flex; flex-direction: column; height: 100%; }
  .cl-knockout-full .cl-tie-team, .cl-knockout-half .cl-tie-team { flex: 1; }
  .cl-ties > .cl-x-only { height: 100%; }
  .screen--lg .cl-knockout-full { --cl-tie-size: 22px; }
  .screen--lg .cl-knockout-horizontal { --cl-tie-size: 24px; }
  .screen--lg .cl-knockout-vertical { --cl-tie-size: 24px; }
  .cl-knockout-full.cl-knockout-sparse { --cl-tie-size: 22px; }
  .cl-knockout-horizontal.cl-knockout-sparse { --cl-tie-size: 20px; }
  .cl-knockout-vertical.cl-knockout-sparse { --cl-tie-size: 18px; }
  .cl-knockout-quadrant.cl-knockout-sparse { --cl-tie-size: 22px; }
  .cl-knockout-full.cl-knockout-final { --cl-tie-size: 32px; }
  .cl-knockout-horizontal.cl-knockout-final { --cl-tie-size: 26px; }
  .cl-knockout-vertical.cl-knockout-final { --cl-tie-size: 22px; }
  .cl-knockout-quadrant.cl-knockout-final { --cl-tie-size: 24px; }
  .screen--lg .cl-knockout-full.cl-knockout-sparse { --cl-tie-size: 36px; }
  .screen--lg .cl-knockout-horizontal.cl-knockout-sparse { --cl-tie-size: 32px; }
  .screen--lg .cl-knockout-vertical.cl-knockout-sparse { --cl-tie-size: 28px; }
  .screen--lg .cl-knockout-quadrant.cl-knockout-sparse { --cl-tie-size: 34px; }
  .screen--lg .cl-knockout-full.cl-knockout-final { --cl-tie-size: 48px; }
  .screen--lg .cl-knockout-horizontal.cl-knockout-final { --cl-tie-size: 40px; }
  .screen--lg .cl-knockout-vertical.cl-knockout-final { --cl-tie-size: 28px; }
  .screen--lg .cl-knockout-quadrant.cl-knockout-final { --cl-tie-size: 34px; }
  .cl-knockout-final .cl-tie { overflow: hidden; }
  .cl-knockout-final .cl-tie-team { min-height: 0; overflow: hidden; }
  .cl-knockout-quadrant .cl-tie { display: flex; flex-direction: column; }
  .cl-knockout-quadrant .cl-tie-team { flex: 1; grid-template-columns: 2.5em minmax(0, 1fr) 1.2em; }
  .cl-knockout-quadrant .cl-tie-crest-frame { width: 2.2em; height: 2.2em; }
  .cl-knockout-vertical .cl-ties--sparse .cl-tie-team { grid-template-columns: 4em minmax(0, 1fr) 1.5em; }
  .cl-knockout-vertical .cl-ties--sparse .cl-tie-crest-frame { width: 3.5em; height: 3.5em; }
  .cl-knockout-vertical .cl-ties--single .cl-tie-team, .cl-knockout-horizontal .cl-ties--single .cl-tie-team { grid-template-columns: 4.5em minmax(0, 1fr) 1.5em; }
  .cl-knockout-vertical .cl-ties--single .cl-tie-crest-frame, .cl-knockout-horizontal .cl-ties--single .cl-tie-crest-frame { width: 4em; height: 4em; }
  .cl-knockout-final .cl-tie-crest-frame { align-self: stretch; width: 90%; height: auto; max-height: 100%; }
  .cl-knockout-final.cl-knockout-horizontal .cl-ties--single .cl-tie-crest-frame, .cl-knockout-final.cl-knockout-vertical .cl-ties--single .cl-tie-crest-frame { height: auto; }
  .cl-knockout-sparse .cl-tie-team { min-height: 0; overflow: hidden; }
  .cl-knockout-sparse .cl-ties--sparse .cl-tie-team .cl-tie-crest-frame { align-self: stretch; width: 90%; height: auto; max-height: 100%; }
  .cl-x-only { display: none; }
  .screen--lg .cl-x-only { display: block; }
  .screen--portrait .cl-x-only { display: block; }
  .cl-x-landscape-only { display: none; }
  .screen--lg:not(.screen--portrait) .cl-x-landscape-only { display: block; height: 100%; }
  .cl-x-portrait-only { display: none; }
  .screen--lg.screen--portrait .cl-x-portrait-only { display: block; }
  .cl-portrait-only { display: none; }
  .screen--portrait .cl-portrait-only { display: block; }
  .screen--portrait .cl-landscape-only { display: none; }
  .screen--lg .cl-og-landscape-only, .screen--portrait .cl-og-landscape-only { display: none; }
  .screen--lg.screen--portrait .cl-not-x-portrait { display: none; }
  .screen--portrait:not(.screen--lg) .cl-full-note { display: none; }
</style>
{% assign table_ok = false %}
{% if plugin_ok == true or plugin_ok == "true" %}{% if rows.size > 0 or round_ties.size > 0 %}{% assign table_ok = true %}{% endif %}{% endif %}
{% if error_message != blank %}{% assign table_error = error_message %}{% else %}{% assign table_error = "Standings are unavailable right now." %}{% endif %}

{% template table_row %}
  <div class="cl-grid cl-row{% if row.position == 8 or row.position == 24 %} cl-row--break{% endif %}{% if row.favorite %} cl-row--favorite{% endif %}">
    <span class="value--tnums cl-strong">{{ row.position }}</span>
    <span class="cl-name{% if row.favorite %} cl-strong{% endif %}">{{ row.name | escape }}</span>
    <span class="value--tnums text--right">{{ row.played }}</span>
    <span class="value--tnums text--right">{{ row.gd_text }}</span>
    <span class="value--tnums text--right cl-strong">{{ row.points }}</span>
  </div>
{% endtemplate %}

{% template neighbor_row %}
  <div class="cl-neighbor-row{% if row.id == focus_id %} cl-neighbor-row--focus{% endif %}">
    <span class="value--tnums cl-strong">{{ row.position }}</span>
    <span class="cl-name{% if row.id == focus_id %} cl-strong{% endif %}">{{ row.name | escape }}</span>
    <span class="value--tnums text--right cl-strong">{{ row.points }}</span>
  </div>
{% endtemplate %}

{% template tie_card %}
  <div class="cl-tie{% if tie.favorite %} cl-tie--favorite{% endif %}{% if round_label == "Final" %} cl-tie--final{% endif %}{% if expanded %} h--full{% endif %} p--1">
    <div class="label label--small text--right">{{ tie.status_label }}</div>
    <div class="cl-tie-team{% if tie.winner_id == tie.home.id %} cl-strong{% endif %}">
      <span class="cl-tie-crest-frame">{% if tie.home.crest != blank %}<img class="image image--contain image-dither cl-tie-crest" src="{{ tie.home.crest }}" alt="">{% endif %}</span>
      <span class="cl-name">{{ tie.home.name | escape }}</span><span class="cl-tie-score value {% if round_label == 'Final' %}value--xlarge{% else %}value--large{% endif %} value--tnums text--right" data-fit-value="true">{{ tie.home_score }}</span>
    </div>
    <div class="cl-tie-team{% if tie.winner_id == tie.away.id %} cl-strong{% endif %}">
      <span class="cl-tie-crest-frame">{% if tie.away.crest != blank %}<img class="image image--contain image-dither cl-tie-crest" src="{{ tie.away.crest }}" alt="">{% endif %}</span>
      <span class="cl-name">{{ tie.away.name | escape }}</span><span class="cl-tie-score value {% if round_label == 'Final' %}value--xlarge{% else %}value--large{% endif %} value--tnums text--right" data-fit-value="true">{{ tie.away_score }}</span>
    </div>
    {% if tie.next_date != blank %}<div class="label label--small cl-tie-meta">Next: {{ tie.next_date }}</div>{% endif %}
  </div>
{% endtemplate %}

{% template table_heading %}
  <div class="cl-grid cl-heading">
    <span>#</span><span>CLUB</span><span class="text--right">P</span><span class="text--right">GD</span><span class="text--right">PTS</span>
  </div>
{% endtemplate %}

{% template error_panel %}
  <div class="layout layout--col flex flex--center">
    <span class="value value--large">Champions League</span>
    <span class="label label--base text--center">{{ message | escape }}</span>
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    <span class="title">{% if compact %}UCL{% else %}Champions League{% endif %}</span>
    <span class="instance">{% if compact %}Data: football-data.org{% else %}Data provided by football-data.org{% endif %}</span>
  </div>
{% endtemplate %}

{% template chef_layout_anchor %}<div class="layout layout--col"></div>{% endtemplate %}
