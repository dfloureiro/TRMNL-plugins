{% assign table_ok = false %}
{% if plugin_ok %}{% if rows.size > 0 or round_ties.size > 0 %}{% assign table_ok = true %}{% endif %}{% endif %}
{% if error_message != blank %}{% assign table_error = error_message %}{% else %}{% assign table_error = "Standings are unavailable right now." %}{% endif %}

{% template table_row %}
  <div class="grid grid--cols-12 gap--xsmall flex--center-y border--h-black w--full{% if row.favorite %} font--bold{% endif %}">
    <span class="col--span-1 value--tnums font--bold {{ text_class }}">{{ row.position }}</span>
    <span class="col--span-7 text--truncate {{ text_class }}">{{ row.name | escape }}</span>
    <span class="col--span-1 value--tnums text--right {{ text_class }}">{{ row.played }}</span>
    <span class="col--span-1 value--tnums text--right {{ text_class }}">{{ row.gd_text }}</span>
    <span class="col--span-2 value--tnums text--right font--bold {{ text_class }}">{{ row.points }}</span>
  </div>
{% endtemplate %}

{% template neighbor_row %}
  <div class="grid grid--cols-12 gap--xsmall flex--center-y border--h-black w--full value value--small lg:value--base{% if row.id == focus_id %} font--bold{% endif %}">
    <span class="col--span-2 value--tnums">{{ row.position }}</span>
    <span class="col--span-8 text--truncate">{{ row.name | escape }}</span>
    <span class="col--span-2 value--tnums text--right">{{ row.points }}</span>
  </div>
{% endtemplate %}

{% template tie_card %}
  <div class="flex flex--col{% if expanded %} h--full{% endif %} w--full outline rounded p--1 lg:p--2">
    <div class="label label--small text--right">{{ tie.status_label }}</div>
    <div class="grid grid--cols-12 gap--xsmall flex--center-y grow border--h-black w--full{% if tie.winner_id == tie.home.id %} font--bold{% endif %}">
      <span class="col--span-2 flex flex--center">{% if tie.home.crest != blank %}<img class="image image--contain image-dither h--[7cqh] w--max-[7cqh] lg:h--[9cqh] lg:w--max-[9cqh]" src="{{ tie.home.crest }}" alt="">{% endif %}</span>
      <span class="col--span-8 label label--base lg:label--large text--truncate">{{ tie.home.name | escape }}</span>
      <span class="col--span-2 value {% if round_label == 'Final' %}value--xlarge lg:value--xxlarge{% else %}value--large lg:value--xlarge{% endif %} value--tnums text--right" data-fit-value="true">{{ tie.home_score }}</span>
    </div>
    <div class="grid grid--cols-12 gap--xsmall flex--center-y grow w--full{% if tie.winner_id == tie.away.id %} font--bold{% endif %}">
      <span class="col--span-2 flex flex--center">{% if tie.away.crest != blank %}<img class="image image--contain image-dither h--[7cqh] w--max-[7cqh] lg:h--[9cqh] lg:w--max-[9cqh]" src="{{ tie.away.crest }}" alt="">{% endif %}</span>
      <span class="col--span-8 label label--base lg:label--large text--truncate">{{ tie.away.name | escape }}</span>
      <span class="col--span-2 value {% if round_label == 'Final' %}value--xlarge lg:value--xxlarge{% else %}value--large lg:value--xlarge{% endif %} value--tnums text--right" data-fit-value="true">{{ tie.away_score }}</span>
    </div>
    {% if tie.next_date != blank %}<div class="label label--small text--center">Next: {{ tie.next_date }}</div>{% endif %}
  </div>
{% endtemplate %}

{% template table_heading %}
  <div class="grid grid--cols-12 gap--xsmall flex--center-y border--h-black w--full font--bold">
    <span class="col--span-1 {{ text_class }}">#</span><span class="col--span-7 {{ text_class }}">CLUB</span><span class="col--span-1 text--right {{ text_class }}">P</span><span class="col--span-1 text--right {{ text_class }}">GD</span><span class="col--span-2 text--right {{ text_class }}">PTS</span>
  </div>
{% endtemplate %}

{% template error_panel %}
  <div class="layout layout--col flex flex--center">
    <span class="value value--large">Champions League</span>
    <span class="label label--base text--center">{{ message | escape }}</span>
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    <span class="title">{% if compact %}UCL{% else %}Champions League{% endif %}</span>
    <span class="instance">{% if compact %}Data: football-data.org{% else %}Data provided by football-data.org{% endif %}</span>
  </div>
{% endtemplate %}
