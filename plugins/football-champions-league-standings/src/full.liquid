{% if table_ok and display_mode == "knockout" %}
<div class="layout layout--col layout--top gap--small cl-knockout-full">
  <div class="flex flex--row flex--between w--full"><span class="label label--base">{{ round_label | upcase }}</span><span class="label label--small">AGGREGATE SCORE</span></div>
  <div class="cl-ties{% if round_ties.size <= 4 %} cl-ties--sparse{% endif %}{% if round_ties.size == 1 %} cl-ties--single{% endif %}">{% for tie in round_ties limit:8 %}{% render "tie_card", tie: tie, round_label: round_label %}{% endfor %}</div>
</div>
{% elsif table_ok %}
<div class="layout layout--col layout--top gap--small">
  <div class="flex flex--row flex--between w--full">
    <span class="label label--base">LEAGUE PHASE</span>
    <span class="label label--small">1–8 DIRECT · 9–24 PLAYOFF</span>
  </div>
  <div class="w--full portrait:hidden">
  <div class="cl-landscape-table">
    <div>{% render "table_heading" %}{% for row in top_rows %}{% render "table_row", row: row %}{% endfor %}</div>
    <div>{% render "table_heading" %}{% for row in lower_rows %}{% render "table_row", row: row %}{% endfor %}</div>
  </div>
  </div>
  <div class="w--full hidden portrait:block">
  <div class="cl-portrait-table">
    {% render "table_heading" %}
    {% for row in rows %}{% render "table_row", row: row %}{% endfor %}
  </div>
  </div>
  <div class="label label--small w--full cl-full-note">Calculated from finished matches{% if has_unresolved_ties %} · unresolved ties possible{% endif %}</div>
</div>
{% else %}
  {% render "error_panel", message: table_error %}
{% endif %}
{% render "title_bar", season_label: season_label %}
