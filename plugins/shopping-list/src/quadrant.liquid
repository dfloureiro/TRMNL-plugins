{% if item_count > 0 %}
<div class="layout layout--col layout--top layout--stretch-x">
  {% render "item_list", items: items, max_cols: 2, box: box_icon, title_class: "title--small lg:title", qty_class: "value--xxsmall", box_class: "w--4 h--4 lg:w--5 lg:h--5" %}
</div>
{% else %}
  {% render "empty_panel", icon: bag_icon, message: t_empty, hint: t_setup, setup: never_synced, app_url: app_url, row: true, qr_class: "w--28 lg:w--36" %}
{% endif %}
{% render "title_bar", icon: bag_icon, title: t_title, meta: meta %}
