{% if table_ok %}
<div class="layout layout--col layout--top gap--small">
  <div class="flex flex--row flex--between w--full">
    <span class="label label--base">PRIMEIRA LIGA</span>
    <span class="label label--small">{% if season_label != blank %}{{ season_label }}{% endif %}</span>
  </div>
  {% if featured != blank %}
    <div class="lg:hidden">{% render "club_hero", focus: featured, favorite_view: true, compact: true %}</div>
    <div class="hidden lg:block">{% render "club_hero", focus: featured, favorite_view: true, expanded: true %}</div>
  {% else %}
    <div class="lg:hidden">{% render "club_hero", focus: leader, compact: true %}</div>
    <div class="hidden lg:block">{% render "club_hero", focus: leader, expanded: true %}</div>
  {% endif %}
  <div class="w--full lg:hidden">
    <div class="w--full">
      {% render "table_heading", text_class: "label label--small" %}
      {% for row in rows limit:9 %}{% render "table_row", row: row, text_class: "label label--small" %}{% endfor %}
    </div>
  </div>
  <div class="w--full hidden lg:block">
    <div>
      {% render "table_heading", text_class: "label label--base" %}
      {% for row in rows limit:15 %}{% render "table_row", row: row, text_class: "label label--base" %}{% endfor %}
    </div>
  </div>
  {% render "zone_legend" %}
</div>
{% else %}
  {% render "error_panel", message: table_error %}
{% endif %}
{% render "title_bar", compact: true %}
