{% comment %}
  TRMNL Frame (2560x1440): the Framework gives it UI scale 1 and no lg: size, so layouts
  would render at OG pixel sizes on a canvas over three times wider. Tripling the device scale
  lays it out like an 853x480 screen, so it gets the OG layouts at three times the size.
  No other device has screen--frame, so they are unaffected.
{% endcomment %}
<style>
  .screen--frame { --device-ui-scale: 3; --gap-scale: 3; }
  /* Framework image sizes do not follow the UI scale, so size the header emblem from it. */
  .screen--frame .brand-emblem { width: calc(36px * var(--ui-scale)); height: calc(36px * var(--ui-scale)); }
</style>

{% comment %} Language: English unless the form (or a top-level value) asks for Portuguese. {% endcomment %}
{% assign lang = "" %}
{% if language != blank %}
  {% assign lang = language %}
{% elsif trmnl.plugin_settings.custom_fields_values.language != blank %}
  {% assign lang = trmnl.plugin_settings.custom_fields_values.language %}
{% else %}
  {% assign lang = "en" %}
{% endif %}
{% assign lang = lang | downcase | strip %}
{% if lang contains "pt" or lang contains "portug" %}
  {% assign lang = "pt" %}
{% else %}
  {% assign lang = "en" %}
{% endif %}
{% if lang == "pt" %}
  {% assign t_matchday = "Jornada" %}
  {% assign t_top_half = "Metade superior" %}
  {% assign t_bottom_half = "Metade inferior" %}
  {% assign t_unavailable = "A classificação não está disponível de momento." %}
{% else %}
  {% assign t_matchday = "Matchday" %}
  {% assign t_top_half = "Top half" %}
  {% assign t_bottom_half = "Bottom half" %}
  {% assign t_unavailable = "Standings are unavailable right now." %}
{% endif %}

{% assign table_ok = false %}
{% if plugin_ok and rows.size > 0 %}{% assign table_ok = true %}{% endif %}
{% if error_message != blank %}{% assign table_error = error_message %}{% else %}{% assign table_error = t_unavailable %}{% endif %}
{% assign league_emblem = emblem | default: "https://crests.football-data.org/PPL.png" %}
{% assign row_count = rows.size %}
{% assign half_count = row_count | plus: 1 | divided_by: 2 %}
{% capture table_meta %}{% if matchday %}{{ t_matchday }} {{ matchday }}{% endif %}{% if matchday and season_label != blank %} · {% endif %}{{ season_label }}{% endcapture %}

{% comment %}
  One standings table. Pass rows, offset, limit, lang ("en" or "pt"), columns ("full", "compact" or "mini"),
  club_class (a w--max-[Ncqw] width cap) and club_chars (character limit) so long names
  shorten instead of squeezing the numbers,
  table_class (Framework table size) and text_class (label size for the cells).
  The favourite club's row is inverted so it reads without colour or grayscale.
{% endcomment %}
{% template standings_table %}
  <table class="table {{ table_class }}" data-table-limit="false">
    <thead>
      <tr>
        <th class="pl--1"><span class="title {{ text_class }}">#</span></th>
        <th><span class="title {{ text_class }}">{% if lang == "pt" %}Clube{% else %}Club{% endif %}</span></th>
        {% if columns != "mini" %}<th class="text--right"><span class="title {{ text_class }}">{% if lang == "pt" %}J{% else %}P{% endif %}</span></th>{% endif %}
        {% if columns == "full" %}
          <th class="text--right"><span class="title {{ text_class }}">{% if lang == "pt" %}V{% else %}W{% endif %}</span></th>
          <th class="text--right"><span class="title {{ text_class }}">{% if lang == "pt" %}E{% else %}D{% endif %}</span></th>
          <th class="text--right"><span class="title {{ text_class }}">{% if lang == "pt" %}D{% else %}L{% endif %}</span></th>
        {% endif %}
        {% if columns != "mini" %}<th class="text--right"><span class="title {{ text_class }}">{% if lang == "pt" %}DG{% else %}GD{% endif %}</span></th>{% endif %}
        <th class="text--right pr--1"><span class="title {{ text_class }}">Pts</span></th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows offset: offset limit: limit %}
        {% if row.favorite %}{% assign cell = "text--white font--bold" %}{% else %}{% assign cell = "" %}{% endif %}
        <tr{% if row.favorite %} class="bg--black"{% endif %}>
          <td class="pl--1"><span class="label {{ text_class }} value--tnums {{ cell }}">{{ row.position }}.</span></td>
          <td><span data-clamp="1" class="label block {{ text_class }} {{ club_class }} {% if row.favorite %}{{ cell }}{% else %}font--bold{% endif %}">{{ row.name | truncate: club_chars, "…" | escape }}</span></td>
          {% if columns != "mini" %}<td class="text--right"><span class="label {{ text_class }} value--tnums {{ cell }}">{{ row.played }}</span></td>{% endif %}
          {% if columns == "full" %}
            <td class="text--right"><span class="label {{ text_class }} value--tnums {{ cell }}">{{ row.won }}</span></td>
            <td class="text--right"><span class="label {{ text_class }} value--tnums {{ cell }}">{{ row.drawn }}</span></td>
            <td class="text--right"><span class="label {{ text_class }} value--tnums {{ cell }}">{{ row.lost }}</span></td>
          {% endif %}
          {% if columns != "mini" %}<td class="text--right"><span class="label {{ text_class }} value--tnums {{ cell }}">{{ row.gd_text }}</span></td>{% endif %}
          <td class="text--right pr--1"><span class="label {{ text_class }} value--tnums font--bold {{ cell }}">{{ row.points }}</span></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endtemplate %}

{% comment %} Centred league wordmark with the competition emblem, as on the full screen. {% endcomment %}
{% comment %}
  Layout variants use four mutually exclusive wrappers:
    OG landscape  "portrait:hidden lg:hidden"
    OG portrait   "hidden portrait:block lg:portrait:hidden"
    X landscape   "hidden lg:block lg:portrait:hidden"
    X portrait    "hidden lg:portrait:block"
  lg:portrait:* is more specific than lg:* and portrait:*, so it wins on TRMNL X portrait.
{% endcomment %}

{% template brand_header %}
  <div class="flex flex--row flex--center gap--small w--full">
    <img src="{{ emblem }}" alt="" class="brand-emblem image image--contain image-dither {{ image_class }}" />
    <span class="title font--bold {{ title_class }}">Liga Portugal Betclic</span>
  </div>
{% endtemplate %}

{% template error_panel %}
  <div class="layout layout--col flex flex--center gap--small">
    <img src="{{ emblem }}" alt="" class="image image--contain image-dither h--16 w--16 lg:h--24 lg:w--24" />
    <span class="title text--center">Liga Portugal Betclic</span>
    <span class="label label--base text--center">{{ message | escape }}</span>
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    <img src="{{ emblem }}" alt="" class="image image-dither" />
    <span class="title">{% if compact %}Liga Portugal{% else %}Liga Portugal Betclic{% endif %}</span>
    {% if meta != blank %}<span class="instance{% if compact %} portrait:hidden lg:portrait:block{% endif %}">{{ meta }}</span>{% endif %}
  </div>
{% endtemplate %}
