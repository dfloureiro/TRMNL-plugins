{% assign table_ok = false %}
{% if plugin_ok and rows.size > 0 %}{% assign table_ok = true %}{% endif %}
{% if error_message != blank %}{% assign table_error = error_message %}{% else %}{% assign table_error = "Standings are unavailable right now." %}{% endif %}
{% assign hero_club = featured | default: leader %}
{% assign has_favorite = false %}
{% if featured != blank %}{% assign has_favorite = true %}{% endif %}

{% template table_row %}
  <div class="grid grid--cols-12 gap--xsmall flex--center-y border--h-black w--full{% if row.favorite %} border--l-black font--bold{% endif %}">
    <span class="col--span-1 value--tnums font--bold {{ text_class }}">{{ row.position }}</span>
    <span class="col--span-7 text--truncate {{ text_class }}">
      <span class="grow text--truncate">{{ row.name | escape }}</span>
    </span>
    <span class="col--span-1 value--tnums text--right {{ text_class }}">{{ row.played }}</span>
    <span class="col--span-1 value--tnums text--right {{ text_class }}">{{ row.gd_text }}</span>
    <span class="col--span-2 value--tnums text--right font--bold {{ text_class }}">{{ row.points }}</span>
  </div>
{% endtemplate %}

{% template table_heading %}
  <div class="grid grid--cols-12 gap--xsmall flex--center-y border--h-black w--full font--bold">
    <span class="col--span-1 {{ text_class }}">#</span>
    <span class="col--span-7 {{ text_class }}">CLUB</span>
    <span class="col--span-1 text--right {{ text_class }}">P</span>
    <span class="col--span-1 text--right {{ text_class }}">GD</span>
    <span class="col--span-2 text--right {{ text_class }}">PTS</span>
  </div>
{% endtemplate %}

{% template zone_legend %}
  <div class="label label--small w--full text--truncate">ZONES · CL 1–4 · EL 5 · ECL 6 · PO 16 · REL 17–18</div>
{% endtemplate %}

{% template club_hero %}
  {% if focus != blank %}
    <div class="flex flex--col flex--between gap--xsmall outline rounded p--1 lg:p--2 w--full h--full">
      <div class="flex flex--row flex--between flex--center-y w--full">
        <span class="label label--small lg:label--base">{% if favorite_view %}YOUR CLUB{% else %}LEAGUE LEADER{% endif %}</span>
        <span class="label label--small lg:label--base">{% if focus.zone_label != blank %}{{ focus.zone_label }}{% else %}MID-TABLE{% endif %}</span>
      </div>
      <div class="flex flex--row flex--center-y gap--small lg:gap--medium w--full grow">
        {% if focus.crest != blank %}
          <img src="{{ focus.crest }}" alt="" class="image image--contain image-dither {% if variant == 'horizontal' or variant == 'quadrant' %}h--20 w--20 lg:h--32 lg:w--32{% elsif variant == 'vertical' %}h--[12cqh] w--[12cqh]{% else %}h--[24cqh] w--[24cqh]{% endif %}" />
        {% endif %}
        <div class="flex flex--col grow text--truncate">
          <span class="label {% if variant == 'full' %}label--large lg:label--xxlarge{% else %}label--base lg:label--xlarge{% endif %} font--bold text--truncate">{{ focus.name | escape }}</span>
          <span class="label label--small lg:label--base">POSITION #{{ focus.position }}</span>
        </div>
        <div class="flex flex--col text--right">
          <span class="value {% if variant == 'full' %}value--xlarge lg:value--giga{% elsif variant == 'vertical' %}value--large lg:value--mega{% elsif variant == 'horizontal' %}value--base lg:value--xlarge{% else %}value--large lg:value--xlarge{% endif %} value--tnums font--bold" data-fit-value="true">{{ focus.points }}</span>
          <span class="label label--small lg:label--base">POINTS</span>
        </div>
      </div>
      <div class="{% if variant == 'horizontal' or variant == 'quadrant' %}hidden lg:flex{% else %}flex{% endif %} flex--row flex--between border--h-black pt--1 w--full label label--small lg:label--base value--tnums">
        <span>{{ focus.played }} PLAYED</span>
        <span>{{ focus.won }}W · {{ focus.drawn }}D · {{ focus.lost }}L</span>
        <span>GD {{ focus.gd_text }}</span>
      </div>
    </div>
  {% endif %}
{% endtemplate %}

{% template error_panel %}
  <div class="layout layout--col flex flex--center">
    <span class="value value--large">Liga Betclic Portugal</span>
    <span class="label label--base text--center">{{ message | escape }}</span>
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    <svg class="image image--adaptive" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="6" aria-hidden="true">
      <circle cx="50" cy="50" r="42" />
      <path d="m50 28 13 9-5 15H42l-5-15 13-9Zm-8 24L28 63l6 15m24-26 14 11-6 15M42 79h16" />
    </svg>
    <span class="title">{% if compact %}Liga Portugal{% else %}Liga Betclic Portugal{% endif %}</span>
    <span class="instance">{% if compact %}Data: football-data.org{% else %}Data provided by football-data.org{% endif %}</span>
  </div>
{% endtemplate %}
