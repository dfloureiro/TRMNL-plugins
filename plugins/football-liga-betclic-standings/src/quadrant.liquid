{% if table_ok %}
<div class="layout layout--col layout--top gap--small">
  <div class="w--full grow">
    {% render "club_hero", focus: hero_club, favorite_view: has_favorite, variant: "quadrant" %}
  </div>
  <div class="w--full shrink-0">
    <div class="lg:hidden">
      {% render "table_heading", text_class: "label label--small" %}
      {% for row in rows limit:3 %}{% render "table_row", row: row, text_class: "label label--small" %}{% endfor %}
    </div>
    <div class="hidden lg:block">
      {% render "table_heading", text_class: "label label--base" %}
      {% for row in rows limit:4 %}{% render "table_row", row: row, text_class: "label label--base" %}{% endfor %}
    </div>
  </div>
</div>
{% else %}
  {% render "error_panel", message: table_error %}
{% endif %}
{% render "title_bar", compact: true %}
