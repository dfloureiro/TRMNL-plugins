{% if table_ok %}
<div class="layout layout--col layout--top gap--small portrait:gap--medium">
  {% render "brand_header", emblem: league_emblem, image_class: "h--10 w--10 portrait:h--16 portrait:w--16 lg:h--16 lg:w--16", title_class: "title--large portrait:title--xlarge lg:title--xlarge" %}
  <div class="grid grid--cols-2 gap--large w--full portrait:hidden">
    <div class="flex flex--col gap--xsmall">
      <span class="label label--underline text--center w--full lg:label--large">{{ t_top_half }}</span>
      {% render "standings_table", rows: rows, lang: lang, offset: 0, limit: half_count, columns: "full", table_class: "table--small lg:table--large", text_class: "label--large lg:label--xlarge", club_class: "w--max-[22cqw]", club_chars: 14 %}
    </div>
    <div class="flex flex--col gap--xsmall">
      <span class="label label--underline text--center w--full lg:label--large">{{ t_bottom_half }}</span>
      {% render "standings_table", rows: rows, lang: lang, offset: half_count, limit: row_count, columns: "full", table_class: "table--small lg:table--large", text_class: "label--large lg:label--xlarge", club_class: "w--max-[22cqw]", club_chars: 14 %}
    </div>
  </div>
  <div class="w--full hidden portrait:block">
    {% render "standings_table", rows: rows, lang: lang, offset: 0, limit: row_count, columns: "full", table_class: "table--small lg:table--base", text_class: "label--large lg:label--xlarge", club_class: "w--max-[50cqw]", club_chars: 26 %}
  </div>
</div>
{% else %}
  {% render "error_panel", message: table_error, emblem: league_emblem %}
{% endif %}
{% render "title_bar", emblem: league_emblem, meta: table_meta %}
