<div class="layout layout--col layout--stretch-x layout--top gap">
  {% if has_articles %}
    {% assign lead = articles[0] %}
    {% render "article_item", article: lead, now: now_ts, lang: lang,
      title_class: "title--large", title_clamp: 2,
      desc_class: "description--base", desc_clamp: 2,
      label_class: "label--small" %}

    <div class="divider"></div>

    <div class="columns news-list" data-overflow-max-cols="2" data-overflow-max-cols-portrait="1">
      <div class="column">
        {% for article in articles offset: 1 %}
          {% render "article_item", article: article, now: now_ts, lang: lang,
            title_class: "title--small lg:title--base", title_clamp: 2,
            label_class: "label--small" %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    {{ empty_state }}
  {% endif %}
</div>

{% render "title_bar", instance_label: instance_label %}
