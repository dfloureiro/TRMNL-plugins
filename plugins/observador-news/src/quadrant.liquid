<div class="layout layout--col layout--stretch-x layout--top">
  {% if has_articles %}
    <div class="columns news-list" data-overflow-max-cols="1">
      <div class="column">
        {% for article in articles %}
          {% render "article_item", article: article, now: now_ts, lang: lang,
            title_class: "title--small", title_clamp: 2, title_clamp_portrait: 3,
            label_class: "label--small" %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    {{ empty_state }}
  {% endif %}
</div>

{% render "title_bar", instance_label: instance_label %}
