{% comment %}
  TRMNL Frame (2560x1440): the Framework gives it UI scale 1 and no lg: size, so tripling
  the device scale lays it out like an 853x480 screen. No other device has screen--frame.
{% endcomment %}
<style>
  .screen--frame { --device-ui-scale: 3; --gap-scale: 3; }
  /* Tighter spacing between headlines so one more fits per column. The overflow engine
     rebuilds columns with a bare class="column", so this has to target the parent. */
  .news-list > .column { gap: calc(var(--gap) * 0.7); }
</style>

{% comment %} Language: Portuguese unless the form (or a top-level value) asks for English. {% endcomment %}
{% assign lang = "" %}
{% if language != blank %}
  {% assign lang = language %}
{% elsif trmnl.plugin_settings.custom_fields_values.language != blank %}
  {% assign lang = trmnl.plugin_settings.custom_fields_values.language %}
{% else %}
  {% assign lang = "pt" %}
{% endif %}
{% assign lang = lang | downcase | strip %}
{% if lang contains "en" %}
  {% assign lang = "en" %}
{% else %}
  {% assign lang = "pt" %}
{% endif %}

{% if lang == "pt" %}
  {% assign t_latest = "Últimas" %}
  {% assign t_empty = "Sem notícias de momento" %}
  {% assign t_empty_section = "Sem notícias recentes nesta secção" %}
  {% assign t_empty_hint = "O feed do Observador será verificado de novo em breve." %}
{% else %}
  {% assign t_latest = "Latest" %}
  {% assign t_empty = "No news right now" %}
  {% assign t_empty_section = "No recent news in this section" %}
  {% assign t_empty_hint = "The Observador feed will be checked again soon." %}
{% endif %}

{% assign now_ts = trmnl.system.timestamp_utc | plus: 0 %}
{% assign has_articles = false %}
{% if articles and articles.size > 0 %}{% assign has_articles = true %}{% endif %}
{% if section_filter != blank %}{% assign instance_label = section_filter %}{% else %}{% assign instance_label = t_latest %}{% endif %}

{% comment %} Relative publish time. Pass ts (epoch seconds), now and lang. {% endcomment %}
{% template time_ago %}
  {%- if ts -%}
    {%- assign mins = now | minus: ts | divided_by: 60 -%}
    {%- assign hours = mins | divided_by: 60 -%}
    {%- assign days = hours | divided_by: 24 -%}
    {%- if lang == "pt" -%}
      {%- if mins < 1 -%}agora
      {%- elsif mins < 60 -%}há {{ mins }} min
      {%- elsif hours < 24 -%}há {{ hours }} h
      {%- elsif days == 1 -%}ontem
      {%- else -%}há {{ days }} dias{%- endif -%}
    {%- else -%}
      {%- if mins < 1 -%}just now
      {%- elsif mins < 60 -%}{{ mins }}m ago
      {%- elsif hours < 24 -%}{{ hours }}h ago
      {%- elsif days == 1 -%}yesterday
      {%- else -%}{{ days }}d ago{%- endif -%}
    {%- endif -%}
  {%- endif -%}
{% endtemplate %}

{% comment %}
  One headline. Pass article, now, lang, title_class and label_class (Framework sizes),
  title_clamp (lines), and desc_class / desc_clamp to show the standfirst (omit to hide it).
  title_clamp_portrait sets a different line limit on portrait screens, where the
  half and quadrant columns are narrow (applied by the script in title_bar).
{% endcomment %}
{% template article_item %}
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="title {{ title_class }}" data-clamp="{{ title_clamp | default: 2 }}"{% if title_clamp_portrait %} data-clamp-portrait="{{ title_clamp_portrait }}"{% endif %}>{{ article.title }}</span>
      {% if desc_class != blank and article.description != blank %}
        <span class="description {{ desc_class }}" data-clamp="{{ desc_clamp | default: 2 }}">{{ article.description }}</span>
      {% endif %}
      <span class="label {{ label_class }} label--gray 1bit:text--black">
        {%- if article.section != blank -%}{{ article.section }}{%- endif -%}
        {%- if article.section != blank and article.pub_ts -%}&nbsp;·&nbsp;{%- endif -%}
        {%- render "time_ago", ts: article.pub_ts, now: now, lang: lang -%}
      </span>
    </div>
  </div>
{% endtemplate %}

{% capture empty_state %}
  <div class="flex flex--col flex--center gap grow text--center">
    <span class="title">{% if section_filter != blank %}{{ t_empty_section }}{% else %}{{ t_empty }}{% endif %}</span>
    <span class="label label--small label--gray 1bit:text--black">{{ t_empty_hint }}</span>
  </div>
{% endcapture %}

{% template title_bar %}
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA0OCA0OCI+PGNpcmNsZSBjeD0iMjQiIGN5PSIyNCIgcj0iMTYiIGZpbGw9Im5vbmUiIHN0cm9rZT0iIzAwMCIgc3Ryb2tlLXdpZHRoPSI5Ii8+PC9zdmc+" alt="Observador">
  <span class="title">Observador</span>
  <span class="instance">{{ instance_label }}</span>
</div>
{% comment %}
  The Framework has no responsive data-clamp, so swap in the portrait line limit here,
  after the headlines are parsed and before the Framework clamps them on DOMContentLoaded.
  The screen--portrait class is part of the served markup.
{% endcomment %}
<script>
  (function () {
    var screen = document.querySelector(".screen");
    if (!screen || !screen.classList.contains("screen--portrait")) return;
    document.querySelectorAll("[data-clamp-portrait]").forEach(function (el) {
      el.setAttribute("data-clamp", el.getAttribute("data-clamp-portrait"));
    });
  })();
</script>
{% endtemplate %}
